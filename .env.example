# Ekam — Profile A (Free) environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Transport ─────────────────────────────────────────────────────────────────
# LiveKit Cloud (Free Build plan) · https://cloud.livekit.io
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── LLM ──────────────────────────────────────────────────────────────────────
# Groq (free tier) · https://console.groq.com
# Used for: fast LLM (Llama 3) + Whisper STT
GROQ_API_KEY=

# Google AI Studio (free tier) · https://aistudio.google.com
# Used for: Gemini Flash fallback LLM
GOOGLE_API_KEY=

# Anthropic (optional for Profile A, used in Phase 1 bake-off)
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── TTS ───────────────────────────────────────────────────────────────────────
# Primary TTS vendor key (Cartesia or ElevenLabs — decided after Phase 1 bake-off)
# Profile A default: Piper/Kokoro (local, no key needed)
TTS_API_KEY=

# ── STT ───────────────────────────────────────────────────────────────────────
# Deepgram (free tier) · https://console.deepgram.com
# Used in Phase 1 bake-off vs Groq Whisper
DEEPGRAM_API_KEY=

# ── Tunnel / Infra ────────────────────────────────────────────────────────────
# Cloudflare Tunnel (for phone access in Profile A without cloud hosting)
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
