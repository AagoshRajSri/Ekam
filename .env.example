# ── Daimon — Profile A (Free) Environment Configuration ───────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Application Identity & Wake Word (Zero Hardcoding) ───────────────────────
# Both the assistant name and wake word are dynamically loaded configuration values.
APP_NAME=Assistant
WAKE_WORD=Awaken
# Optional phonetic respelling for TTS only (e.g. Daymon if APP_NAME=Daimon).
# If unset, APP_NAME is passed directly to TTS.
TTS_NAME_RESPELL=

# ── LiveKit Transport & Cloud Connectivity ───────────────────────────────────
# LiveKit Cloud (Free Build tier) · https://cloud.livekit.io
# To explicitly target the Mumbai region, configure an ap-south domain endpoint or set LIVEKIT_REGION:
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_REGION=ap-south
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Speech-to-Text (STT) & Primary LLM ───────────────────────────────────────
# Groq Cloud (Free Tier) · https://console.groq.com
# Used for:
#   - STT: whisper-large-v3-turbo (Streaming / Utterance-based)
#   - Primary LLM: qwen/qwen3.8-27b (Streaming, 120 max tokens, thinking OFF)
#   - Guarded TTS: canopylabs/orpheus-v1-english (capped at 100 req/hour rolling)
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Secondary LLM Failover (Google AI Studio) ────────────────────────────────
# Google AI Studio (Free Tier) · https://aistudio.google.com
# Used for: gemini-3.8-flash (Streaming fallback when Groq hits 429/5xx)
GOOGLE_API_KEY=AIzaSy_your_google_ai_studio_api_key_here

# ── Tertiary LLM Failover (Local Ollama) ─────────────────────────────────────
# Local Ollama daemon (Offline, zero network, zero quota)
# Used for: qwen2.5:7b (Local fallback when cloud APIs are unavailable)
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Text-to-Speech (TTS) Provider Selection ──────────────────────────────────
# Options:
#   groq  -> Guarded Groq Orpheus (100 req/hr ceiling, proactive fallback to Piper)
#   piper -> Local Piper ONNX CPU (en_US-lessac-medium, zero network/cost)
#   local -> LocalMockTTS (zero external API calls; recommended for dev & tests)
TTS_PROVIDER=local

# ── Voice Turn & Interruption Tuning (Optional) ──────────────────────────────
# Minimum silence (seconds) before committing user turn (default 0.5s for fast response)
ENDPOINTING_MIN_DELAY=0.5
# Maximum silence fallback (seconds) when EOT probability is uncertain (default 1.8s, avoids 3s stall)
ENDPOINTING_MAX_DELAY=1.8
# Silero VAD activation threshold (0.0 to 1.0, default 0.40 for sensitive voice pickup)
VAD_ACTIVATION_THRESHOLD=0.40
# Acoustic Echo Cancellation warmup grace period (seconds, default 0.5s for headphones)
AEC_WARMUP_DURATION=0.5
