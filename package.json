{
  "name": "daimon",
  "version": "0.0.0",
  "private": true,
  "description": "Daimon — real-time voice-first personal AI (monorepo root)",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm --filter @daimon/web dev",
    "dev:gateway": "pnpm --filter @daimon/gateway dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=7.0.0 <11.0.1": "11.0.5"
    }
  }
}
